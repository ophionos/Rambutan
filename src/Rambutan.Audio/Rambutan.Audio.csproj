<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <InternalsVisibleTo Include="Rambutan.Audio.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rambutan.Core\Rambutan.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- SoundFlow (miniaudio backend) for device output.
         FFmpeg.AutoGen dynamically-loaded bindings for decode; native libs are
         managed as a sidecar by Rambutan.Streams and located at runtime. -->
    <PackageReference Include="FFmpeg.AutoGen.Bindings.DynamicallyLoaded" Version="9.0.1.1" />
    <PackageReference Include="SoundFlow" Version="1.4.1" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- FFmpeg interop is pointer-based by nature. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

</Project>
