    <StreamGeometry x:Key="Icon.Pin">M14 4v5c0 1.12.37 2.16 1 3H9c.65-.86 1-1.9 1-3V4h4m3-2H7c-.55 0-1 .45-1 1s.45 1 1 1h1v5c0 1.66-1.34 3-3 3v2h5.97v7l1 1 1-1v-7H19v-2c-1.66 0-3-1.34-3-3V4h1c.55 0 1-.45 1-1s-.45-1-1-1z M0 0h.01v.01H0zM23.99 23.99h.01v.01h-.01z</StreamGeometry>
    <StreamGeometry x:Key="Icon.PinFilled">M16 9V4h1c.55 0 1-.45 1-1s-.45-1-1-1H7c-.55 0-1 .45-1 1s.45 1 1 1h1v5c0 1.66-1.34 3-3 3v2h5.97v7l1 1 1-1v-7H19v-2c-1.66 0-3-1.34-3-3z M0 0h.01v.01H0zM23.99 23.99h.01v.01h-.01z</StreamGeometry>
    <StreamGeometry x:Key="Icon.MusicNote">M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z M0 0h.01v.01H0zM23.99 23.99h.01v.01h-.01z</StreamGeometry>
  </Styles.Resources>

  <Style Selector="Button.icon">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="7" />
    <!-- Oversized radius clamps to a circle for any icon size. -->
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Foreground" Value="#FFE6E6EA" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Same 120 ms hover fade the card/nav surfaces use (Controls.axaml). -->
  <Style Selector="Button.icon /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.12" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Button.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Token.Brush.Overlay.1F}" />
    <Setter Property="Foreground" Value="{StaticResource Token.Brush.White}" />
  </Style>

  <Style Selector="Button.icon:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{StaticResource Token.Brush.Overlay.2B}" />
  </Style>

  <Style Selector="Button.icon:disabled">
    <Setter Property="Opacity" Value="0.3" />
  </Style>

  <!-- Fluent paints disabled buttons with a grey fill; an icon button has no
       fill at rest, so disabled only dims it (the idle transport). -->
  <Style Selector="Button.icon:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- Secondary actions sit quieter than the transport until hovered. -->
  <Style Selector="Button.icon.subtle">
    <Setter Property="Foreground" Value="#FFB6B6BE" />
  </Style>

  <!-- Compact pill for in-row actions (track lists, queue panel): same flat
       circular hover, smaller footprint. Pair with a 16px PathIcon in track
       rows, 14px in the queue panel. -->
  <Style Selector="Button.icon.small">
    <Setter Property="Padding" Value="5" />
  </Style>

  <!-- Repeat/shuffle when engaged. -->
  <Style Selector="Button.icon.active">
    <Setter Property="Foreground" Value="{StaticResource Token.Brush.Accent}" />
  </Style>

  <Style Selector="Button.icon.active /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{StaticResource Token.Brush.Accent}" />
  </Style>

  <!-- A like/dislike toggle whose rating is in effect (Controls/RateButton).
       The control swaps in the filled glyph; this adds the accent,
       same as an engaged repeat. -->
  <Style Selector="Button.icon:rated">
    <Setter Property="Foreground" Value="{StaticResource Token.Brush.Accent}" />
  </Style>

  <Style Selector="Button.icon:rated /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{StaticResource Token.Brush.Accent}" />
  </Style>

  <!-- Seek slider: input + a thumb that only appears under the pointer, so the
       bar reads as a progress line at rest. It draws no lines of its own — the
       track, buffered range, and played fill are drawn behind it in the player
       bar (its track/fill brushes are blanked via resource overrides there). -->
  <Style Selector="Slider.seek">
    <Setter Property="Height" Value="14" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
  </Style>

  <Style Selector="Slider.seek /template/ Track#PART_Track RepeatButton">
    <Setter Property="Height" Value="3" />
  </Style>

  <Style Selector="Slider.seek /template/ Track#PART_Track Thumb">
    <Setter Property="Width" Value="10" />
    <Setter Property="Height" Value="10" />
    <Setter Property="Opacity" Value="0" />
    <!-- The template arranges the thumb 2px below the drawn line (measured);
         nudge it back onto the line. -->
    <Setter Property="RenderTransform" Value="translateY(-2px)" />
  </Style>

  <Style Selector="Slider.seek:pointerover /template/ Track#PART_Track Thumb">
    <Setter Property="Opacity" Value="1" />
  </Style>

  <Style Selector="Slider.volume">
    <Setter Property="Height" Value="18" />
    <Setter Property="MinHeight" Value="0" />
    <!-- The template's track sits 3px below the control's visual center
         (measured against the neighboring icon centers); lift the whole
         slider so the line aligns with the icon row. -->
    <Setter Property="RenderTransform" Value="translateY(-3px)" />
  </Style>

  <!-- Both sliders are shorter than the template's 32px track row, and the
       Slider and its DataValidationErrors clip to their bounds, so the thumb
       lost its bottom pixels (measured: the thumb ends 1px past the 18px
       volume slider, more with anti-aliasing). Let it draw past the edge. -->
  <Style Selector="Slider.seek, Slider.volume">
    <Setter Property="ClipToBounds" Value="False" />
  </Style>

  <Style Selector="Slider.seek /template/ DataValidationErrors, Slider.volume /template/ DataValidationErrors">
    <Setter Property="ClipToBounds" Value="False" />
  </Style>

  <Style Selector="Slider.volume /template/ Track#PART_Track RepeatButton">
    <Setter Property="Height" Value="3" />
  </Style>

  <Style Selector="Slider.volume /template/ Track#PART_Track Thumb">
    <Setter Property="Width" Value="11" />
    <Setter Property="Height" Value="11" />
  </Style>
</Styles>
