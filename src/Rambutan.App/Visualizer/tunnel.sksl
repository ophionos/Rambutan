// Tunnel: rings spaced by the logarithm of the distance, so they come
// towards the viewer at an even pace, crossed by spokes that turn with the
// mids. The centre is dark, and widens at low resolutions, where the rings
// would crowd into noise.
//
// u[0] = (width, height, phase, activity), sizes in pixels
// u[1] = (bass, mid, high, beat), eased, 0..1
// u[2] = (red, green, blue, 0), 0..1
uniform float4 u[3];

float feather(float2 p, float2 res) {
    float2 e = min(p, res - p) / min(res.x, res.y);
    return smoothstep(0.0, 0.15, min(e.x, e.y));
}

half4 main(float2 p) {
    float2 res = u[0].xy;
    float t = u[0].z;
    float bass = u[1].x;
    float mid = u[1].y;
    float high = u[1].z;
    float beat = u[1].w;
    float3 base = u[2].rgb;

    float2 q = (p - 0.5 * res) / res.y;
    float r = max(length(q), 0.0001);
    float angle = atan(q.y, q.x);

    float depth = -log(r) * 4.0 + t * 6.2831853;
    float rings = 0.5 + 0.5 * sin(depth);
    float spokes = 0.5 + 0.5 * sin(angle * 6.0 + t * 0.8 + depth * 0.15 * (1.0 + mid));
    float pattern = mix(rings, rings * spokes, 0.6);

    // Where a ring would be thinner than about two pixels.
    float limit = 8.0 / res.y;
    float near = smoothstep(limit, limit * 2.5, r);

    float3 col = mix(base * 0.12, base, pattern) * near;
    col *= 0.7 + 0.08 * bass + 0.06 * beat;
    col = mix(col, float3(1.0), 0.12 * high * pattern * near);
    float a = feather(p, res);
    return half4(half3(col * a), half(a));
}
