<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:Rambutan.App.Localization"
             xmlns:vm="using:Rambutan.App.ViewModels"
             xmlns:controls="using:Rambutan.App.Controls"
             xmlns:views="using:Rambutan.App.Views"
             xmlns:core="using:Rambutan.Core.Models"
             x:Class="Rambutan.App.Views.ArtistPage"
             x:Name="Root"
             x:DataType="vm:ArtistPageViewModel">

  <Panel>
  <!-- Load failed with nothing to show: the failure takes the page. -->
  <ContentControl Margin="0,0,12,0" Content="{Binding LoadError}"
                  ContentTemplate="{StaticResource ErrorState.Full}"
                  HorizontalAlignment="Center" VerticalAlignment="Center" />
  <ScrollViewer Classes="pagescroll" IsVisible="{Binding LoadError, Converter={x:Static ObjectConverters.IsNull}}"
                controls:ScrollMemory.IsEnabled="True">
    <StackPanel Spacing="14" Margin="4,0">

      <Grid ColumnDefinitions="Auto,*">
        <Border Classes="heroart" CornerRadius="88" Width="176" Height="176">
          <controls:RemoteImage Url="{Binding ThumbnailUrl}" Stretch="UniformToFill" />
        </Border>
        <StackPanel Grid.Column="1" Margin="24,0,0,0" Spacing="12" VerticalAlignment="Center">
          <TextBlock Classes="herotitle" Text="{Binding Name}" />
          <controls:ActionRow Spacing="10">
            <Button Classes="accent heroprimary" controls:ActionRow.Keep="True" Command="{Binding PlayTopSongsCommand}"
                    IsEnabled="{Binding !!TopSongs.Count}"
                    ToolTip.Tip="{l:T artist.playTopSongs}" AutomationProperties.Name="{l:T artist.playTopSongs}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <PathIcon Data="{StaticResource Icon.Play}" Width="18" Height="18" VerticalAlignment="Center" />
                <TextBlock Text="{l:T artist.playTopSongs}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <!-- Only when the header has YouTube Music's Shuffle. -->
            <Button Classes="icon outline" Command="{Binding ShuffleSongsCommand}" IsVisible="{Binding CanShuffleSongs}"
                    ToolTip.Tip="{l:T artist.shuffleSongs}" AutomationProperties.Name="{l:T artist.shuffleSongs}">
              <PathIcon Data="{StaticResource Icon.Shuffle}" Width="18" Height="18" />
            </Button>
            <!-- Only when the header has YouTube Music's Mix. -->
            <Button Classes="icon outline" Command="{Binding StartMixCommand}" IsVisible="{Binding CanStartMix}"
                    ToolTip.Tip="{l:T menu.startMix}" AutomationProperties.Name="{l:T menu.startMix}">
              <PathIcon Data="{StaticResource Icon.Radio}" Width="18" Height="18" />
            </Button>
            <!-- Shown only when the state is known. The bell is filled in the
                 accent while subscribed; the name and tooltip say what a press does. -->
            <Button Classes="icon outline" Command="{Binding ToggleSubscribedCommand}"
                    IsVisible="{Binding CanSubscribe}"
                    ToolTip.Tip="{Binding Subscribed, Converter={x:Static vm:Converters.SubscribeAction}}"
                    AutomationProperties.Name="{Binding Subscribed, Converter={x:Static vm:Converters.SubscribeAction}}">
              <Panel>
                <PathIcon Data="{StaticResource Icon.Subscribe}" Width="18" Height="18"
                          IsVisible="{Binding Subscribed, Converter={x:Static vm:Converters.IsNotTrue}, FallbackValue=True}" />
                <PathIcon Data="{StaticResource Icon.Subscribed}" Width="18" Height="18"
                          Foreground="{StaticResource Token.Brush.Accent}"
                          IsVisible="{Binding Subscribed, Converter={x:Static vm:Converters.IsTrue}, FallbackValue=False}" />
              </Panel>
            </Button>
            <!-- Only while Last.fm stations are on and connected. -->
            <Button Classes="icon outline" controls:ActionRow.InMenu="True"
                    Command="{Binding OpenStationCommand}" IsVisible="{Binding CanOpenStation}"
                    AutomationProperties.Name="{l:T artist.lastFmStation}">
              <PathIcon Data="{StaticResource Icon.Radio}" Width="18" Height="18" />
            </Button>
            <ProgressBar IsIndeterminate="True" Width="80" AutomationProperties.Name="{l:T common.loading}" IsVisible="{Binding IsLoading}" />
          </controls:ActionRow>

        </StackPanel>
      </Grid>

      <TextBlock Text="{l:T artist.topSongs}" FontSize="{StaticResource Token.Font.Section}" FontWeight="Bold" Margin="0,8,0,0" />

      <StackPanel Spacing="8">
        <StackPanel.IsVisible>
          <MultiBinding Converter="{x:Static BoolConverters.And}">
            <Binding Path="IsLoading" />
            <Binding Path="!TopSongs.Count" />
          </MultiBinding>
        </StackPanel.IsVisible>
        <Border Classes="skeleton" Height="48" CornerRadius="8" />
        <Border Classes="skeleton" Height="48" CornerRadius="8" />
        <Border Classes="skeleton" Height="48" CornerRadius="8" />
        <Border Classes="skeleton" Height="48" CornerRadius="8" />
        <Border Classes="skeleton" Height="48" CornerRadius="8" />
      </StackPanel>

      <!-- The rows are shared with the album page's side column. -->
      <views:TopSongRows Songs="{Binding TopSongs}" ListName="{l:T artist.topSongs}"
                         PlayFromCommand="{Binding PlayFromCommand}" />

      <ItemsControl ItemsSource="{Binding Shelves}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="core:Shelf">
            <views:ShelfView Margin="0,6,0,14"
                             OpenCommand="{Binding #Root.((vm:ArtistPageViewModel)DataContext).OpenEntryCommand}"
                             PlayCommand="{Binding #Root.((vm:ArtistPageViewModel)DataContext).PlayEntryCommand}" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
  </Panel>
</UserControl>
