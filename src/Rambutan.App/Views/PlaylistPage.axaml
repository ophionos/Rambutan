<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:Rambutan.App.Localization"
             xmlns:vm="using:Rambutan.App.ViewModels"
             xmlns:controls="using:Rambutan.App.Controls"
             xmlns:core="using:Rambutan.Core.Models"
             xmlns:conv="using:Rambutan.App.Converters"
             x:Class="Rambutan.App.Views.PlaylistPage"
             x:Name="Root"
             x:DataType="vm:PlaylistPageViewModel">

  <Grid RowDefinitions="Auto,*,Auto">
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="4,0,16,20">
      <Grid.IsVisible>
        <!-- A failed first load has no title, art or tracks to head: the
             error state takes the page instead of an empty header. -->
        <MultiBinding Converter="{x:Static BoolConverters.Or}">
          <Binding Path="LoadError" Converter="{x:Static ObjectConverters.IsNull}" />
          <Binding Path="!!Tracks.Count" />
        </MultiBinding>
      </Grid.IsVisible>
      <Border Classes="heroart" Width="176" Height="176">
        <controls:RemoteImage Url="{Binding ThumbnailUrl}" Stretch="UniformToFill" />
      </Border>
      <StackPanel Grid.Column="1" Margin="24,0,0,0" Spacing="6" VerticalAlignment="Bottom">
        <TextBlock Classes="herotitle" Text="{Binding Title}" />
        <!-- Owner • Playlist • 2026, as an album header puts its artist first.
             The owner is a link when YTM gave it a channel. -->
        <WrapPanel Orientation="Horizontal">
          <Button Classes="textlink"
                  IsVisible="{Binding Owner.BrowseId, Converter={x:Static ObjectConverters.IsNotNull}, FallbackValue=False}"
                  ToolTip.Tip="{l:T playlist.goToOwner}"
                  Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).Actions.GoToArtistCommand}"
                  CommandParameter="{Binding Owner}">
            <TextBlock Text="{Binding Owner.Name}" />
          </Button>
          <TextBlock Classes="headermeta" Text="{Binding Owner.Name}"
                     IsVisible="{Binding Owner.BrowseId, Converter={x:Static ObjectConverters.IsNull}, FallbackValue=False}" />
          <TextBlock Classes="headermeta" Text=" • ">
            <TextBlock.IsVisible>
              <MultiBinding Converter="{x:Static BoolConverters.And}">
                <Binding Path="Owner" Converter="{x:Static ObjectConverters.IsNotNull}" />
                <Binding Path="Details" Converter="{x:Static StringConverters.IsNotNullOrEmpty}" />
              </MultiBinding>
            </TextBlock.IsVisible>
          </TextBlock>
          <TextBlock Classes="headermeta" Text="{Binding Details}"
                     IsVisible="{Binding Details, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </WrapPanel>
        <TextBlock Classes="headersummary" Text="{Binding Summary}"
                   IsVisible="{Binding Summary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <!-- The copy kept with the downloads: says so, with its date, and
             offers a retry that loads the live page over it. -->
        <!-- Retry is a button under the notice, not a link at the far end of
             the line, where it read as plain text. -->
        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto"
              IsVisible="{Binding KeptNotice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
          <PathIcon Data="{StaticResource Icon.Download}" Width="14" Height="14" Opacity="0.7"
                    VerticalAlignment="Top" Margin="0,2,8,0" />
          <TextBlock Grid.Column="1" Classes="headermeta" Text="{Binding KeptNotice}" TextWrapping="Wrap"
                     AutomationProperties.LiveSetting="Polite" />
          <Button Grid.Row="1" Grid.Column="1" Content="{l:T common.retry}" Command="{Binding ReloadCommand}"
                  HorizontalAlignment="Left" Margin="0,8,0,0" Padding="12,2" MinHeight="0"
                  FontSize="{StaticResource Token.Font.Caption}" />
        </Grid>
        <!-- One filled action, then outlined icons: Play all carries the
             hierarchy by shape and colour, so the rest can drop their labels.
             Each keeps its name as a tooltip and an accessible name. -->
        <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,12,0,0">
          <Button Classes="cardplay hero" Command="{Binding PlayAllCommand}"
                  IsEnabled="{Binding !!Tracks.Count}"
                  ToolTip.Tip="{l:T common.playAll}" AutomationProperties.Name="{l:T common.playAll}">
            <PathIcon Data="{StaticResource Icon.Play}" Width="24" Height="24" />
          </Button>
          <Button Classes="icon outline" Command="{Binding ShuffleCommand}" IsEnabled="{Binding !!Tracks.Count}"
                  ToolTip.Tip="{l:T playlist.shuffleTip}" AutomationProperties.Name="{l:T common.shuffle}">
            <PathIcon Data="{StaticResource Icon.Shuffle}" Width="18" Height="18" />
          </Button>
          <!-- The collection's download state: the arrow, a progress
               ring round it while jobs run, and a filled check once all is
               downloaded, when a press removes the downloads (with Undo). -->
          <Button Classes="icon outline" Command="{Binding DownloadButton.PressCommand}" IsEnabled="{Binding !!Tracks.Count}"
                  IsVisible="{Binding CanDownload}"
                  ToolTip.Tip="{Binding DownloadButton.Tip}" AutomationProperties.Name="{Binding DownloadButton.Name}">
            <Panel>
              <PathIcon Data="{StaticResource Icon.Download}" Width="18" Height="18"
                        IsVisible="{Binding !DownloadButton.IsDownloaded, FallbackValue=True}" />
              <PathIcon Data="{StaticResource Icon.DownloadDone}" Width="18" Height="18"
                        Foreground="{StaticResource Token.Brush.Accent}"
                        IsVisible="{Binding DownloadButton.IsDownloaded, FallbackValue=False}" />
              <Arc Classes="downloadprogress" SweepAngle="{Binding DownloadButton.SweepAngle, FallbackValue=0}"
                   IsVisible="{Binding DownloadButton.IsDownloading, FallbackValue=False}" />
            </Panel>
          </Button>
          <Button Classes="icon outline" Command="{Binding CopyToLocalCommand}" IsEnabled="{Binding !!Tracks.Count}"
                  IsVisible="{Binding CanCopyToLocal}"
                  ToolTip.Tip="{l:T playlist.copyToLocalTip}" AutomationProperties.Name="{l:T menu.copyToLocalPlaylist}">
            <PathIcon Data="{StaticResource Icon.AddToPlaylist}" Width="18" Height="18" />
          </Button>
          <!-- Rename and Delete only on the account's own playlists. -->
          <Button Classes="icon outline" Command="{Binding RenameCommand}" IsVisible="{Binding IsEditable}"
                  ToolTip.Tip="{l:T common.rename}" AutomationProperties.Name="{l:T common.rename}">
            <PathIcon Data="{StaticResource Icon.Edit}" Width="18" Height="18" />
          </Button>
          <Button Classes="icon outline" Command="{Binding DeleteCommand}" IsVisible="{Binding IsEditable}"
                  ToolTip.Tip="{l:T common.delete}" AutomationProperties.Name="{l:T common.delete}">
            <PathIcon Data="{StaticResource Icon.Delete}" Width="18" Height="18" />
          </Button>
          <ProgressBar IsIndeterminate="True" Width="80" AutomationProperties.Name="{l:T common.loading}" IsVisible="{Binding IsLoading}" />
        </StackPanel>
        <ContentControl Content="{Binding LoadError}"
                      ContentTemplate="{StaticResource ErrorState.Compact}"
                      VerticalAlignment="Center" HorizontalAlignment="Left"
                      IsVisible="{Binding !!Tracks.Count}" />
      </StackPanel>
    </Grid>


    <StackPanel Grid.Row="1" Spacing="8" VerticalAlignment="Top" Margin="4,0,16,0">
      <StackPanel.IsVisible>
        <MultiBinding Converter="{x:Static BoolConverters.And}">
          <Binding Path="IsLoading" />
          <Binding Path="!Tracks.Count" />
        </MultiBinding>
      </StackPanel.IsVisible>
      <Border Classes="skeleton" Height="40" CornerRadius="6" />
      <Border Classes="skeleton" Height="40" CornerRadius="6" />
      <Border Classes="skeleton" Height="40" CornerRadius="6" />
      <Border Classes="skeleton" Height="40" CornerRadius="6" />
      <Border Classes="skeleton" Height="40" CornerRadius="6" />
      <Border Classes="skeleton" Height="40" CornerRadius="6" />
      <Border Classes="skeleton" Height="40" CornerRadius="6" />
    </StackPanel>

    <!-- On a playlist the account owns, drag a row or press Alt+↑/↓ on the
         selected one to move it (Controls/DragReorder, as in the queue). -->
    <ListBox x:Name="TrackList" Grid.Row="1" Classes="tracks pagescroll" Background="Transparent" ItemsSource="{Binding Tracks}"
             AutomationProperties.Name="{l:T common.tracks}"
             AutomationProperties.HelpText="{Binding ListHelp}"
             controls:ScrollMemory.IsEnabled="True"
             controls:RowNumber.IsEnabled="True"
             controls:DragReorder.Command="{Binding DragReorderCommand}"
             controls:ItemActivation.Command="{Binding PlayFromCommand}">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="core:TrackInfo">
          <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" Margin="0,2"
                Background="Transparent"
                controls:TrackMenu.Track="{Binding}"
                controls:TrackMenu.Host="{Binding #Root.((vm:PlaylistPageViewModel)DataContext)}">
            <!-- Row number, or the playing marker in its place. The number
                 is the row's position (Controls/RowNumber), so it continues across
                 Load more and closes up after a remove. -->
            <Panel Grid.Column="0" Width="28" Margin="0,0,12,0">
              <TextBlock Classes="tracknumber" Text="{Binding $parent[ListBoxItem].(controls:RowNumber.Number)}">
                <TextBlock.IsVisible>
                  <MultiBinding Converter="{x:Static conv:IsPlayingTrackConverter.Inverted}">
                    <Binding Path="Identity" />
                    <Binding Path="$parent[Window].((vm:MainViewModel)DataContext).Player.NowPlaying.Identity" />
                  </MultiBinding>
                </TextBlock.IsVisible>
              </TextBlock>
              <PathIcon Data="{StaticResource Icon.Play}" Width="12" Height="12"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Foreground="{StaticResource Token.Brush.Accent}">
                <PathIcon.IsVisible>
                  <MultiBinding Converter="{x:Static conv:IsPlayingTrackConverter.Instance}">
                    <Binding Path="Identity" />
                    <Binding Path="$parent[Window].((vm:MainViewModel)DataContext).Player.NowPlaying.Identity" />
                  </MultiBinding>
                </PathIcon.IsVisible>
              </PathIcon>
            </Panel>
            <Border Grid.Column="1" Classes="rowart">
              <controls:RemoteImage Url="{Binding ThumbnailUrl}" Stretch="UniformToFill" />
            </Border>
            <StackPanel Grid.Column="2" Spacing="1" VerticalAlignment="Center">
              <TextBlock Classes="rowtitle" Text="{Binding Title}" />
              <!-- The downloaded mark leads the meta line, so titles keep their edge. -->
              <DockPanel>
                <PathIcon DockPanel.Dock="Left" Classes="downloadmark">
                  <PathIcon.IsVisible>
                    <MultiBinding Converter="{x:Static conv:IsDownloadedConverter.Instance}">
                      <Binding Path="VideoId" />
                      <Binding Path="$parent[Window].((vm:MainViewModel)DataContext).Actions.DownloadedIds" />
                    </MultiBinding>
                  </PathIcon.IsVisible>
                </PathIcon>
                <TextBlock Classes="rowmeta" Text="{Binding ArtistDisplay}" />
              </DockPanel>
            </StackPanel>
            <TextBlock Grid.Column="4" Classes="rowmeta"
                       Text="{Binding Duration, Converter={x:Static conv:DurationFormat.Converter}}"
                       MinWidth="40" TextAlignment="Right" VerticalAlignment="Center" Margin="8,0" />
            <!-- One wider slot: this surface carries a fifth action (remove). -->
            <Panel Grid.Column="3" Width="138">
              <StackPanel Classes="rowactions" Orientation="Horizontal"
                          HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Classes="icon subtle small" ToolTip.Tip="{l:T common.playFromHere}"
                        Command="{Binding #Root.((vm:PlaylistPageViewModel)DataContext).PlayFromCommand}"
                        CommandParameter="{Binding}">
                  <PathIcon Data="{StaticResource Icon.Play}" Width="16" Height="16" />
                </Button>
                <Button Classes="icon subtle small" ToolTip.Tip="{l:T common.addToQueue}"
                        Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).Actions.AddToQueueCommand}"
                        CommandParameter="{Binding}">
                  <PathIcon Data="{StaticResource Icon.Add}" Width="16" Height="16" />
                </Button>
                <controls:RateButton Classes="icon subtle small" IconSize="16" Kind="Like"
                                     Track="{Binding}"
                                     Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).Actions.LikeCommand}"
                                     CommandParameter="{Binding}" />
                <Button Classes="icon subtle small" ToolTip.Tip="{l:T common.addToPlaylist}"
                        Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).Actions.AddToPlaylistCommand}"
                        CommandParameter="{Binding}">
                  <PathIcon Data="{StaticResource Icon.AddToPlaylist}" Width="16" Height="16" />
                </Button>
                <Button Classes="icon subtle small"
                        IsVisible="{Binding #Root.((vm:PlaylistPageViewModel)DataContext).IsEditable}"
                        ToolTip.Tip="{l:T playlist.removeTip}"
                        Command="{Binding #Root.((vm:PlaylistPageViewModel)DataContext).RemoveTrackCommand}"
                        CommandParameter="{Binding}">
                  <PathIcon Data="{StaticResource Icon.Delete}" Width="16" Height="16" />
                </Button>
              </StackPanel>
            </Panel>
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <!-- The next page loads as the list nears its end (code-behind); this
         only says so while it does. A failed page shows its Try again above. -->
    <ProgressBar Grid.Row="2" IsIndeterminate="True" Width="80" HorizontalAlignment="Left" Margin="4,8,16,8"
                 AutomationProperties.Name="{l:T common.loading}" IsVisible="{Binding IsLoadingMore}" />

    <!-- Load failed with nothing to show: the failure takes the page. Declared last so it sits above the
         (empty, but hit-testable) list in the same cell, which would otherwise
         swallow clicks on Try again and Details. -->
    <ContentControl Margin="0,0,12,0" Grid.Row="1" Content="{Binding LoadError}"
                    ContentTemplate="{StaticResource ErrorState.Full}"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    IsVisible="{Binding !Tracks.Count}" />
  </Grid>
</UserControl>
