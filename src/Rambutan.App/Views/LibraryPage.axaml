<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:Rambutan.App.Localization"
             xmlns:vm="using:Rambutan.App.ViewModels"
             xmlns:controls="using:Rambutan.App.Controls"
             xmlns:views="using:Rambutan.App.Views"
             xmlns:core="using:Rambutan.Core.Models"
             xmlns:local="using:Rambutan.Core.Local"
             xmlns:conv="using:Rambutan.App.Converters"
             x:Class="Rambutan.App.Views.LibraryPage"
             x:Name="Root"
             x:DataType="vm:LibraryPageViewModel">

  <Grid RowDefinitions="Auto,Auto,*,Auto">
    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="4,0,16,8">
      <TextBlock Text="{l:T library.title}" FontSize="{StaticResource Token.Font.Page}" FontWeight="ExtraBold" VerticalAlignment="Center" />
      <!-- Two sources, both in view; shown signed out too, so the files stay reachable. -->
      <ListBox Classes="segmented" VerticalAlignment="Center" HorizontalAlignment="Left"
               ItemsSource="{Binding Sources}" SelectedItem="{Binding Source}"
               SelectionMode="AlwaysSelected"
               IsVisible="{Binding HasLocal}"
               AutomationProperties.Name="{l:T library.source.name}">
        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:LibrarySource">
            <TextBlock Text="{Binding Converter={x:Static vm:Converters.LibrarySourceName}}" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <Button Classes="icon subtle" ToolTip.Tip="{l:T common.refresh}" Command="{Binding SelectedSection.RefreshCommand}">
        <Button.IsVisible>
          <MultiBinding Converter="{x:Static BoolConverters.And}">
            <Binding Path="IsYouTubeMusic" />
            <Binding Path="!SelectedSection.NeedsSignIn" />
          </MultiBinding>
        </Button.IsVisible>
        <PathIcon Data="{StaticResource Icon.Refresh}" Width="18" Height="18" />
      </Button>
      <Button VerticalAlignment="Center"
              Command="{Binding NewPlaylistCommand}">
        <Button.IsVisible>
          <MultiBinding Converter="{x:Static BoolConverters.And}">
            <Binding Path="IsYouTubeMusic" />
            <Binding Path="IsPlaylists" />
            <Binding Path="!SelectedSection.NeedsSignIn" />
          </MultiBinding>
        </Button.IsVisible>
        <StackPanel Orientation="Horizontal" Spacing="6">
          <PathIcon Data="{StaticResource Icon.Add}" Width="14" Height="14" VerticalAlignment="Center" />
          <TextBlock Text="{l:T library.newPlaylist}" FontWeight="SemiBold" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
      <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsYouTubeMusic}">
        <ProgressBar IsIndeterminate="True" Width="80" AutomationProperties.Name="{l:T common.loading}" IsVisible="{Binding SelectedSection.IsLoading}" />
        <!-- Offline, the albums and playlists tabs list the downloaded ones;
             the refresh button beside the title is the retry. -->
        <TextBlock Classes="headermeta" Text="{Binding SelectedSection.OfflineNotice}" VerticalAlignment="Center"
                   IsVisible="{Binding SelectedSection.IsOfflineCopy}" AutomationProperties.LiveSetting="Polite" />
        <ContentControl Content="{Binding SelectedSection.LoadError}"
                        ContentTemplate="{StaticResource ErrorState.Compact}"
                        VerticalAlignment="Center" Margin="6,0,0,0"
                        IsVisible="{Binding !!SelectedSection.Items.Count}" />
      </StackPanel>
      <!-- On this computer: rescan, and where the scan is. -->
      <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsThisComputer}">
        <Button Classes="icon subtle" ToolTip.Tip="{l:T settings.local.rescan}"
                AutomationProperties.Name="{l:T settings.local.rescan}"
                Command="{Binding Local.RescanCommand}">
          <Button.IsVisible>
            <MultiBinding Converter="{x:Static BoolConverters.And}">
              <Binding Path="Local.HasFolders" />
              <Binding Path="Local.ListsFiles" />
            </MultiBinding>
          </Button.IsVisible>
          <PathIcon Data="{StaticResource Icon.Refresh}" Width="18" Height="18" />
        </Button>
        <ProgressBar IsIndeterminate="True" Width="80" AutomationProperties.Name="{Binding Local.Status}">
          <ProgressBar.IsVisible>
            <MultiBinding Converter="{x:Static BoolConverters.And}">
              <Binding Path="Local.IsScanning" />
              <Binding Path="Local.ListsFiles" />
            </MultiBinding>
          </ProgressBar.IsVisible>
        </ProgressBar>
        <TextBlock Classes="headermeta" Text="{Binding Local.Status}" VerticalAlignment="Center"
                   IsVisible="{Binding Local.Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   AutomationProperties.LiveSetting="Polite" />
        <TextBlock Classes="headermeta" Text="{Binding Local.Problems}" VerticalAlignment="Center"
                   Foreground="{StaticResource Token.Brush.Text.Muted}"
                   IsVisible="{Binding Local.Problems, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>
    </StackPanel>

    <!-- One tab per kind of thing the library keeps, as Search has one per filter. -->
    <controls:ChipList Grid.Row="1" Classes="chips" Margin="4,0,16,12"
                       AutomationProperties.Name="{l:T library.sectionsName}"
                       ItemsSource="{Binding Sections}"
                       SelectedItem="{Binding SelectedSection}"
                       SelectionMode="AlwaysSelected"
                       Background="Transparent">
      <controls:ChipList.IsVisible>
        <MultiBinding Converter="{x:Static BoolConverters.And}">
          <Binding Path="IsYouTubeMusic" />
          <Binding Path="!SelectedSection.NeedsSignIn" />
        </MultiBinding>
      </controls:ChipList.IsVisible>
      <controls:ChipList.ItemTemplate>
        <DataTemplate x:DataType="vm:LibrarySection">
          <TextBlock Text="{Binding Kind, Converter={x:Static vm:Converters.LibrarySectionName}}" />
        </DataTemplate>
      </controls:ChipList.ItemTemplate>
      <controls:ChipList.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel Orientation="Horizontal" Spacing="8" />
        </ItemsPanelTemplate>
      </controls:ChipList.ItemsPanel>
    </controls:ChipList>

    <Panel Grid.Row="2" DataContext="{Binding SelectedSection}" x:DataType="vm:LibrarySection"
           IsVisible="{Binding #Root.((vm:LibraryPageViewModel)DataContext).IsYouTubeMusic}">
      <StackPanel Margin="0,0,12,0" Classes="empty" IsVisible="{Binding NeedsSignIn}">
        <PathIcon Data="{StaticResource Icon.Person}" />
        <TextBlock Classes="title" Text="{l:T library.signInTitle}" />
        <TextBlock Classes="hint"
                   Text="{l:T library.signInHint}" />
        <!-- The action is here, not "in the sidebar". -->
        <Button Classes="accent" Content="{l:T common.signIn}" HorizontalAlignment="Center" Margin="0,10,0,0"
                Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).Session.SignInCommand}" />
      </StackPanel>

      <!-- Placeholders shaped like what is coming: rows for songs, cards for the rest. -->
      <Panel Margin="0,0,12,0">
        <Panel.IsVisible>
          <MultiBinding Converter="{x:Static BoolConverters.And}">
            <Binding Path="IsLoading" />
            <Binding Path="!Items.Count" />
            <Binding Path="!NeedsSignIn" />
          </MultiBinding>
        </Panel.IsVisible>
        <WrapPanel Orientation="Horizontal" ItemSpacing="4" LineSpacing="8" Margin="4,0"
                   IsVisible="{Binding !IsSongs}">
          <Border Classes="skeleton" Width="176" Height="262" CornerRadius="12" />
          <Border Classes="skeleton" Width="176" Height="262" CornerRadius="12" />
          <Border Classes="skeleton" Width="176" Height="262" CornerRadius="12" />
          <Border Classes="skeleton" Width="176" Height="262" CornerRadius="12" />
          <Border Classes="skeleton" Width="176" Height="262" CornerRadius="12" />
          <Border Classes="skeleton" Width="176" Height="262" CornerRadius="12" />
        </WrapPanel>
        <StackPanel Spacing="8" Margin="4,0" IsVisible="{Binding IsSongs}">
          <Border Classes="skeleton" Height="48" CornerRadius="8" />
          <Border Classes="skeleton" Height="48" CornerRadius="8" />
          <Border Classes="skeleton" Height="48" CornerRadius="8" />
          <Border Classes="skeleton" Height="48" CornerRadius="8" />
          <Border Classes="skeleton" Height="48" CornerRadius="8" />
          <Border Classes="skeleton" Height="48" CornerRadius="8" />
        </StackPanel>
      </Panel>

      <StackPanel Margin="0,0,12,0" Classes="empty">
        <StackPanel.IsVisible>
          <MultiBinding Converter="{x:Static BoolConverters.And}">
            <Binding Path="!NeedsSignIn" />
            <Binding Path="!IsLoading" />
            <Binding Path="!Items.Count" />
            <Binding Path="LoadError" Converter="{x:Static ObjectConverters.IsNull}" />
          </MultiBinding>
        </StackPanel.IsVisible>
        <PathIcon Data="{StaticResource Icon.Library}" />
        <TextBlock Classes="title" Text="{Binding Kind, Converter={x:Static vm:Converters.LibraryEmptyTitle}}" />
        <TextBlock Classes="hint" Text="{Binding Kind, Converter={x:Static vm:Converters.LibraryEmptyHint}}" />
      </StackPanel>

      <!-- Scrolling near the end loads the next page, as playlists do;
           Load more below stays as the fallback. -->
      <ScrollViewer x:Name="Scroller" Classes="pagescroll" IsVisible="{Binding !NeedsSignIn}"
                    controls:ScrollMemory.IsEnabled="True">
        <Panel>
        <ItemsControl ItemsSource="{Binding Items}" Margin="4,0"
                      IsVisible="{Binding !IsSongs}"
                      controls:CollectionMenu.InLibrary="{Binding !IsOfflineCopy}"
                      AutomationProperties.Name="{Binding Kind, Converter={x:Static vm:Converters.LibrarySectionName}}"
                      controls:RovingFocus.IsEnabled="True">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal" ItemSpacing="4" LineSpacing="8" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="core:CatalogEntry">
              <views:EntryCard OpenCommand="{Binding #Root.((vm:LibraryPageViewModel)DataContext).OpenEntryCommand}"
                               PlayCommand="{Binding #Root.((vm:LibraryPageViewModel)DataContext).PlayEntryCommand}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Songs are track rows, as in a filtered search: a plain panel, since
             the scroller above owns scrolling. A song plays with the loaded rows
             as its queue. -->
        <ListBox Classes="tracks" Background="Transparent" Margin="4,0"
                 IsVisible="{Binding IsSongs}"
                 ItemsSource="{Binding Items}"
                 AutomationProperties.Name="{Binding Kind, Converter={x:Static vm:Converters.LibrarySectionName}}"
                 controls:ItemActivation.Command="{Binding #Root.((vm:LibraryPageViewModel)DataContext).PlaySongCommand}">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <!-- Typed, not the ItemTemplate: while hidden on another tab this list
               still shares that tab's items, which aren't songs. -->
          <ListBox.DataTemplates>
            <DataTemplate DataType="{x:Type core:SongEntry}">
              <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" Margin="0,2"
                    Background="Transparent"
                    controls:TrackMenu.Track="{Binding Track}">
                <Border Classes="rowart">
                  <controls:RemoteImage Url="{Binding ThumbnailUrl}" Stretch="UniformToFill" DecodeWidth="96" />
                </Border>
                <!-- Playing marker; the slot is always present, so titles line up. -->
                <Panel Grid.Column="1" Width="14">
                  <PathIcon Data="{StaticResource Icon.Play}" Width="12" Height="12"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource Token.Brush.Accent}">
                    <PathIcon.IsVisible>
                      <MultiBinding Converter="{x:Static conv:IsPlayingTrackConverter.Instance}">
                        <Binding Path="Track.Identity" />
                        <Binding Path="$parent[Window].((vm:MainViewModel)DataContext).Player.NowPlaying.Identity" />
                      </MultiBinding>
                    </PathIcon.IsVisible>
                  </PathIcon>
                </Panel>
                <StackPanel Grid.Column="2" Spacing="1" VerticalAlignment="Center">
                  <TextBlock Classes="rowtitle" Text="{Binding Title}" />
                  <DockPanel>
                    <PathIcon DockPanel.Dock="Left" Classes="downloadmark">
                      <PathIcon.IsVisible>
                        <MultiBinding Converter="{x:Static conv:IsDownloadedConverter.Instance}">
                          <Binding Path="Track.VideoId" />
                          <Binding Path="$parent[Window].((vm:MainViewModel)DataContext).Actions.DownloadedIds" />
                        </MultiBinding>
                      </PathIcon.IsVisible>
                    </PathIcon>
                    <TextBlock Classes="rowmeta" Text="{Binding Subtitle}"
                               IsVisible="{Binding Subtitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  </DockPanel>
                </StackPanel>
                <TextBlock Grid.Column="4" Classes="rowmeta" Text="{Binding Track.Duration, Converter={x:Static conv:DurationFormat.Converter}}"
                           MinWidth="40" TextAlignment="Right" VerticalAlignment="Center" Margin="8,0" />
                <!-- Fixed width and before the duration, as on Search's rows. -->
                <Panel Grid.Column="3" Width="112">
                  <StackPanel Classes="rowactions" Orientation="Horizontal"
                              HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Classes="icon subtle small" ToolTip.Tip="{l:T common.play}"
                            Command="{Binding #Root.((vm:LibraryPageViewModel)DataContext).PlaySongCommand}"
                            CommandParameter="{Binding}">
                      <PathIcon Data="{StaticResource Icon.Play}" Width="16" Height="16" />
                    </Button>
                    <Button Classes="icon subtle small" ToolTip.Tip="{l:T common.addToQueue}"
                            Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).Actions.AddToQueueCommand}"
                            CommandParameter="{Binding Track}">
                      <PathIcon Data="{StaticResource Icon.Add}" Width="16" Height="16" />
                    </Button>
                    <controls:RateButton Classes="icon subtle small" IconSize="16" Kind="Like"
                                         Track="{Binding Track}"
                                         Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).Actions.LikeCommand}"
                                         CommandParameter="{Binding Track}" />
                    <Button Classes="icon subtle small" ToolTip.Tip="{l:T common.addToPlaylist}"
                            Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).Actions.AddToPlaylistCommand}"
                            CommandParameter="{Binding Track}">
                      <PathIcon Data="{StaticResource Icon.AddToPlaylist}" Width="16" Height="16" />
                    </Button>
                  </StackPanel>
                </Panel>
              </Grid>
            </DataTemplate>
          </ListBox.DataTemplates>
        </ListBox>
        </Panel>
      </ScrollViewer>

      <!-- Load failed with nothing to show: the failure takes the page. Declared last so it sits above the
           (empty, but hit-testable) list in the same cell, which would otherwise
           swallow clicks on Try again and Details. -->
      <ContentControl Margin="0,0,12,0" Content="{Binding LoadError}"
                      ContentTemplate="{StaticResource ErrorState.Full}"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      IsVisible="{Binding !Items.Count}" />
    </Panel>


    <!-- On this computer. Its own list with its own scroller, so a library of
         thousands of files is virtualized. -->
    <DockPanel Grid.Row="1" Grid.RowSpan="3"
               IsVisible="{Binding #Root.((vm:LibraryPageViewModel)DataContext).IsThisComputer}"
               DataContext="{Binding Local}" x:DataType="vm:LocalLibraryViewModel">
      <controls:ChipList DockPanel.Dock="Top" Classes="chips" Margin="4,0,16,12"
                         AutomationProperties.Name="{l:T library.local.filterName}"
                         ItemsSource="{Binding Filters}"
                         SelectedItem="{Binding Filter}"
                         SelectionMode="AlwaysSelected"
                         Background="Transparent"
                         IsVisible="{Binding ShowsFilters}">
        <controls:ChipList.ItemTemplate>
          <DataTemplate x:DataType="local:LocalSource">
            <TextBlock Text="{Binding Converter={x:Static vm:Converters.LocalSourceName}}" />
          </DataTemplate>
        </controls:ChipList.ItemTemplate>
        <controls:ChipList.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" Spacing="8" />
          </ItemsPanelTemplate>
        </controls:ChipList.ItemsPanel>
      </controls:ChipList>

      <!-- Downloading: on top under every filter, only while jobs exist, in its
           own short scroller so a long playlist doesn't push the list away. -->
      <StackPanel DockPanel.Dock="Top" Spacing="6" Margin="4,0,16,16"
                  DataContext="{Binding Downloads}" x:DataType="vm:DownloadsViewModel"
                  IsVisible="{Binding HasJobs, FallbackValue=False}">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock Classes="sectiontitle" Text="{l:T downloads.active}" VerticalAlignment="Center" />
          <TextBlock Classes="rowmeta" Text="{Binding JobsSummary}" VerticalAlignment="Center" />
          <Button Content="{l:T downloads.retryAll}" Command="{Binding RetryAllCommand}"
                  IsVisible="{Binding HasFailed}" FontSize="12" VerticalAlignment="Center" />
          <Button Content="{l:T downloads.cancelAll}" Command="{Binding CancelAllCommand}"
                  FontSize="12" VerticalAlignment="Center" />
        </StackPanel>
        <!-- Three and a half rows: the half row says the list scrolls. -->
        <ScrollViewer MaxHeight="182">
          <!-- Indented as the track list's items are by their padding. -->
          <ItemsControl ItemsSource="{Binding Jobs}" Margin="8,0" AutomationProperties.Name="{l:T downloads.activeListName}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:DownloadJobRow">
                <Grid ColumnDefinitions="Auto,*,200,Auto" Margin="0,2" Height="48">
                  <Border Classes="rowart">
                    <controls:RemoteImage Url="{Binding Track.ThumbnailUrl}" Stretch="UniformToFill" />
                  </Border>
                  <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                    <TextBlock Classes="rowtitle" Text="{Binding Track.Title}" />
                    <TextBlock Classes="rowmeta" Text="{Binding Track.ArtistDisplay}" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center" Margin="12,0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <PathIcon Data="{StaticResource Icon.Warning}" Width="14" Height="14"
                                Foreground="{StaticResource Token.Brush.Error}" IsVisible="{Binding IsFailed}" />
                      <TextBlock Classes="rowmeta" Text="{Binding Status}" ToolTip.Tip="{Binding Error}" />
                    </StackPanel>
                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding Percent}" Height="4" MinHeight="4"
                                 IsIndeterminate="{Binding !HasProgress}"
                                 AutomationProperties.Name="{Binding Track.Title}">
                      <ProgressBar.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                          <Binding Path="!IsFailed" />
                          <Binding Path="!IsWaiting" />
                        </MultiBinding>
                      </ProgressBar.IsVisible>
                    </ProgressBar>
                  </StackPanel>
                  <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                    <Button Classes="icon subtle small" IsVisible="{Binding IsFailed}"
                            Command="{Binding #Root.((vm:LibraryPageViewModel)DataContext).Local.Downloads.RetryCommand}"
                            CommandParameter="{Binding}"
                            ToolTip.Tip="{l:T downloads.retry}" AutomationProperties.Name="{l:T downloads.retry}">
                      <PathIcon Data="{StaticResource Icon.Refresh}" Width="16" Height="16" />
                    </Button>
                    <Button Classes="icon subtle small"
                            Command="{Binding #Root.((vm:LibraryPageViewModel)DataContext).Local.Downloads.CancelCommand}"
                            CommandParameter="{Binding}"
                            ToolTip.Tip="{l:T downloads.cancel}" AutomationProperties.Name="{l:T downloads.cancel}">
                      <PathIcon Data="{StaticResource Icon.Close}" Width="16" Height="16" />
                    </Button>
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </StackPanel>

      <!-- The Downloads filter: Play all and Export, or an export's progress in
           Export's place. The space used is the status line above. -->
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12" Margin="4,0,16,12"
                  DataContext="{Binding Downloads}" x:DataType="vm:DownloadsViewModel">
        <StackPanel.IsVisible>
          <MultiBinding Converter="{x:Static BoolConverters.And}">
            <Binding Path="#Root.((vm:LibraryPageViewModel)DataContext).Local.IsDownloadsFilter" />
            <Binding Path="HasDownloaded" FallbackValue="False" />
          </MultiBinding>
        </StackPanel.IsVisible>
        <Button Classes="cardplay" VerticalAlignment="Center"
                Command="{Binding #Root.((vm:LibraryPageViewModel)DataContext).Local.PlayAllCommand}"
                ToolTip.Tip="{l:T common.playAll}" AutomationProperties.Name="{l:T common.playAll}">
          <PathIcon Data="{StaticResource Icon.Play}" Width="18" Height="18" />
        </Button>
        <Button Content="{l:T downloads.export}" Command="{Binding ExportAllCommand}" IsEnabled="{Binding CanExport}"
                VerticalAlignment="Center" AutomationProperties.Name="{l:T downloads.export}">
          <Button.IsVisible>
            <MultiBinding Converter="{x:Static BoolConverters.And}">
              <Binding Path="ExportEnabled" />
              <Binding Path="!IsExporting" />
            </MultiBinding>
          </Button.IsVisible>
        </Button>
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" IsVisible="{Binding IsExporting}">
          <TextBlock Classes="rowmeta" Text="{Binding ExportStatus}" VerticalAlignment="Center"
                     AutomationProperties.LiveSetting="Polite" />
          <Button Content="{l:T downloads.export.cancel}" Command="{Binding CancelExportCommand}"
                  VerticalAlignment="Center" />
        </StackPanel>
      </StackPanel>

      <!-- The Playlists filter: New playlist, as the YouTube Music side has,
           and Import, which reads every file's tags (the bar shows it). -->
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12" Margin="4,0,16,12">
        <StackPanel.IsVisible>
          <MultiBinding Converter="{x:Static BoolConverters.And}">
            <Binding Path="IsPlaylistsFilter" />
            <Binding Path="CanCreatePlaylist" />
          </MultiBinding>
        </StackPanel.IsVisible>
        <Button Command="{Binding #Root.((vm:LibraryPageViewModel)DataContext).NewLocalPlaylistCommand}"
                AutomationProperties.Name="{l:T library.newPlaylist}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <PathIcon Data="{StaticResource Icon.Add}" Width="16" Height="16" />
            <TextBlock Text="{l:T library.newPlaylist}" />
          </StackPanel>
        </Button>
        <Button Command="{Binding #Root.((vm:LibraryPageViewModel)DataContext).ImportLocalPlaylistCommand}"
                AutomationProperties.Name="{l:T library.local.importPlaylist}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <PathIcon Data="{StaticResource Icon.AddToPlaylist}" Width="16" Height="16" />
            <TextBlock Text="{l:T library.local.importPlaylist}" />
          </StackPanel>
        </Button>
        <ProgressBar IsIndeterminate="True" Width="80" VerticalAlignment="Center"
                     AutomationProperties.Name="{l:T common.loading}"
                     IsVisible="{Binding #Root.((vm:LibraryPageViewModel)DataContext).IsImportingPlaylist}" />
      </StackPanel>

      <Panel>
        <StackPanel Margin="0,0,12,0" Classes="empty" IsVisible="{Binding NoPlaylists}">
          <PathIcon Data="{StaticResource Icon.Queue}" />
          <TextBlock Classes="title" Text="{l:T library.local.noPlaylistsTitle}" />
          <TextBlock Classes="hint" Text="{l:T library.local.noPlaylistsHint}" />
        </StackPanel>

        <ListBox Classes="tracks" Background="Transparent" Margin="4,0,12,0"
                 ItemsSource="{Binding Playlists}"
                 IsVisible="{Binding !!Playlists.Count}"
                 AutomationProperties.Name="{l:T library.local.playlistsName}"
                 controls:ItemActivation.Command="{Binding #Root.((vm:LibraryPageViewModel)DataContext).OpenLocalPlaylistCommand}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:LocalPlaylistRow">
              <Grid ColumnDefinitions="Auto,*" Margin="0,2" Background="Transparent">
                <Border Classes="rowart">
                  <Panel>
                    <PathIcon Data="{StaticResource Icon.Queue}" Width="16" Height="16" Opacity="0.35" />
                    <controls:RemoteImage Url="{Binding Cover, Converter={x:Static conv:ArtworkConverter.Instance}}"
                                          Stretch="UniformToFill" DecodeWidth="96" />
                  </Panel>
                </Border>
                <StackPanel Grid.Column="1" Classes="rowtext" Spacing="1" VerticalAlignment="Center" Margin="14,0,0,0">
                  <TextBlock Classes="rowtitle" Text="{Binding Name}" />
                  <TextBlock Classes="rowmeta" Text="{Binding Summary}" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Margin="0,0,12,0" Classes="empty" IsVisible="{Binding NeedsFolders}">
          <PathIcon Data="{StaticResource Icon.MusicNote}" />
          <TextBlock Classes="title" Text="{l:T library.local.noFoldersTitle}" />
          <TextBlock Classes="hint" Text="{l:T library.local.noFoldersHint}" />
          <Button Classes="accent" Content="{l:T library.local.openSettings}" HorizontalAlignment="Center" Margin="0,10,0,0"
                  Command="{Binding #Root.((vm:LibraryPageViewModel)DataContext).OpenSettingsCommand}" />
        </StackPanel>

        <StackPanel Margin="0,0,12,0" Classes="empty" IsVisible="{Binding IsEmpty}">
          <PathIcon Data="{StaticResource Icon.MusicNote}" />
          <TextBlock Classes="title" Text="{l:T library.local.emptyTitle}" />
          <TextBlock Classes="hint" Text="{l:T library.local.emptyHint}" />
          <Button Content="{l:T library.local.openSettings}" HorizontalAlignment="Center" Margin="0,10,0,0"
                  Command="{Binding #Root.((vm:LibraryPageViewModel)DataContext).OpenSettingsCommand}" />
        </StackPanel>

        <StackPanel Margin="0,0,12,0" Classes="empty" IsVisible="{Binding NoDownloads}">
          <PathIcon Data="{StaticResource Icon.Download}" />
          <TextBlock Classes="title" Text="{l:T downloads.emptyTitle}" />
          <TextBlock Classes="hint" Text="{l:T downloads.emptyHint}" />
        </StackPanel>

        <!-- A first scan before any file is read: rows shaped like what is coming. -->
        <StackPanel Spacing="8" Margin="4,0,16,0">
          <StackPanel.IsVisible>
            <MultiBinding Converter="{x:Static BoolConverters.And}">
              <Binding Path="IsScanning" />
              <Binding Path="!Tracks.Count" />
              <Binding Path="ListsFiles" />
            </MultiBinding>
          </StackPanel.IsVisible>
          <Border Classes="skeleton" Height="48" CornerRadius="8" />
          <Border Classes="skeleton" Height="48" CornerRadius="8" />
          <Border Classes="skeleton" Height="48" CornerRadius="8" />
          <Border Classes="skeleton" Height="48" CornerRadius="8" />
        </StackPanel>

        <ListBox Classes="tracks" Background="Transparent" Margin="4,0,12,0"
                 ItemsSource="{Binding Tracks}"
                 IsVisible="{Binding !!Tracks.Count}"
                 AutomationProperties.Name="{l:T library.local.listName}"
                 controls:ItemActivation.Command="{Binding PlayCommand}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:LocalTrackRow">
              <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" Margin="0,2"
                    Background="Transparent"
                    Classes.missing="{Binding IsMissing}"
                    controls:TrackMenu.Track="{Binding Track}">
                <Border Classes="rowart">
                  <Panel>
                    <PathIcon Data="{StaticResource Icon.MusicNote}" Width="16" Height="16" Opacity="0.35" />
                    <controls:RemoteImage Url="{Binding Track, Converter={x:Static conv:ArtworkConverter.Instance}}"
                                          Stretch="UniformToFill" DecodeWidth="96" />
                  </Panel>
                </Border>
                <!-- Playing marker; the slot is always present, so titles line up. -->
                <Panel Grid.Column="1" Width="14">
                  <PathIcon Data="{StaticResource Icon.Play}" Width="12" Height="12"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource Token.Brush.Accent}">
                    <PathIcon.IsVisible>
                      <MultiBinding Converter="{x:Static conv:IsPlayingTrackConverter.Instance}">
                        <Binding Path="Track.Identity" />
                        <Binding Path="$parent[Window].((vm:MainViewModel)DataContext).Player.NowPlaying.Identity" />
                      </MultiBinding>
                    </PathIcon.IsVisible>
                  </PathIcon>
                </Panel>
                <StackPanel Grid.Column="2" Classes="rowtext" Spacing="1" VerticalAlignment="Center">
                  <TextBlock Classes="rowtitle" Text="{Binding Title}" />
                  <TextBlock Classes="rowmeta" Text="{Binding Subtitle}"
                             IsVisible="{Binding Subtitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
                <!-- Play and queue; a download adds its own actions. -->
                <Panel Grid.Column="3" MinWidth="112">
                  <StackPanel Classes="rowactions" Orientation="Horizontal"
                              HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Classes="icon subtle small" ToolTip.Tip="{l:T common.play}"
                            AutomationProperties.Name="{l:T common.play}"
                            IsVisible="{Binding !IsMissing}"
                            Command="{Binding #Root.((vm:LibraryPageViewModel)DataContext).Local.PlayCommand}"
                            CommandParameter="{Binding}">
                      <PathIcon Data="{StaticResource Icon.Play}" Width="16" Height="16" />
                    </Button>
                    <Button Classes="icon subtle small" ToolTip.Tip="{l:T common.addToQueue}"
                            AutomationProperties.Name="{l:T common.addToQueue}"
                            IsVisible="{Binding !IsMissing}"
                            Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).Actions.AddToQueueCommand}"
                            CommandParameter="{Binding Track}">
                      <PathIcon Data="{StaticResource Icon.Add}" Width="16" Height="16" />
                    </Button>
                    <Button Classes="icon subtle small"
                            Command="{Binding #Root.((vm:LibraryPageViewModel)DataContext).Local.Downloads.ExportOneCommand}"
                            CommandParameter="{Binding Download}"
                            IsEnabled="{Binding #Root.((vm:LibraryPageViewModel)DataContext).Local.Downloads.CanExport, FallbackValue=False}"
                            ToolTip.Tip="{l:T downloads.export.one}" AutomationProperties.Name="{l:T downloads.export.one}">
                      <Button.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                          <Binding Path="#Root.((vm:LibraryPageViewModel)DataContext).Local.IsDownloadsFilter" />
                          <Binding Path="#Root.((vm:LibraryPageViewModel)DataContext).Local.Downloads.ExportEnabled" FallbackValue="False" />
                          <Binding Path="IsDownload" />
                          <Binding Path="!IsMissing" />
                        </MultiBinding>
                      </Button.IsVisible>
                      <PathIcon Data="{StaticResource Icon.Export}" Width="16" Height="16" />
                    </Button>
                    <Button Classes="icon subtle small" IsVisible="{Binding IsMissing}"
                            Command="{Binding #Root.((vm:LibraryPageViewModel)DataContext).Local.Downloads.DownloadAgainCommand}"
                            CommandParameter="{Binding Download}"
                            ToolTip.Tip="{l:T downloads.downloadAgain}" AutomationProperties.Name="{l:T downloads.downloadAgain}">
                      <PathIcon Data="{StaticResource Icon.Download}" Width="16" Height="16" />
                    </Button>
                    <Button Classes="icon subtle small" IsVisible="{Binding IsDownload}"
                            Command="{Binding #Root.((vm:LibraryPageViewModel)DataContext).Local.Downloads.RemoveCommand}"
                            CommandParameter="{Binding Download}"
                            ToolTip.Tip="{l:T downloads.remove}" AutomationProperties.Name="{l:T downloads.remove}">
                      <PathIcon Data="{StaticResource Icon.Delete}" Width="16" Height="16" />
                    </Button>
                  </StackPanel>
                </Panel>
                <Panel Grid.Column="4" Margin="8,0">
                  <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center"
                              IsVisible="{Binding IsMissing}" ToolTip.Tip="{l:T downloads.missingTip}">
                    <PathIcon Data="{StaticResource Icon.Warning}" Width="14" Height="14"
                              Foreground="{StaticResource Token.Brush.Error}" />
                    <TextBlock Classes="rowmeta" Text="{l:T downloads.missing}" />
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" VerticalAlignment="Center"
                              IsVisible="{Binding !IsMissing}">
                    <TextBlock Classes="rowmeta" Text="{Binding Size}">
                      <TextBlock.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                          <Binding Path="#Root.((vm:LibraryPageViewModel)DataContext).Local.IsDownloadsFilter" />
                          <Binding Path="IsDownload" />
                        </MultiBinding>
                      </TextBlock.IsVisible>
                    </TextBlock>
                    <TextBlock Classes="rowmeta" MinWidth="40" TextAlignment="Right"
                               Text="{Binding Track.Duration, Converter={x:Static conv:DurationFormat.Converter}}" />
                  </StackPanel>
                </Panel>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Panel>
    </DockPanel>

    <!-- The next page loads as the list nears its end (code-behind); this
         only says so while it does. A failed page shows its Try again above. -->
    <ProgressBar Grid.Row="3" IsIndeterminate="True" Width="80" HorizontalAlignment="Left" Margin="4,8,16,8"
                 AutomationProperties.Name="{l:T common.loading}">
      <ProgressBar.IsVisible>
        <MultiBinding Converter="{x:Static BoolConverters.And}">
          <Binding Path="IsYouTubeMusic" />
          <Binding Path="SelectedSection.IsLoadingMore" />
        </MultiBinding>
      </ProgressBar.IsVisible>
    </ProgressBar>
  </Grid>
</UserControl>
