<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:Rambutan.App.Localization"
             xmlns:vm="using:Rambutan.App.ViewModels"
             xmlns:controls="using:Rambutan.App.Controls"
             xmlns:core="using:Rambutan.Core.Models"
             x:Class="Rambutan.App.Views.MoodsPage"
             x:Name="Root"
             x:DataType="vm:MoodsPageViewModel">

  <!-- Moods & genres: a group of tiles per heading, as YouTube Music
       sends them. A tile opens that mood's or genre's page. -->
  <Grid RowDefinitions="Auto,*">
    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="4,0,16,12">
      <TextBlock Text="{l:T moods.title}" FontSize="{StaticResource Token.Font.Page}" FontWeight="ExtraBold" VerticalAlignment="Center" />
      <ProgressBar IsIndeterminate="True" Width="80" AutomationProperties.Name="{l:T common.loading}" IsVisible="{Binding IsLoading}" />
    </StackPanel>

    <!-- First-load skeleton: one group of tile shapes. -->
    <StackPanel Grid.Row="1" Margin="4,0,16,0" Spacing="10">
      <StackPanel.IsVisible>
        <MultiBinding Converter="{x:Static BoolConverters.And}">
          <Binding Path="IsLoading" />
          <Binding Path="!Sections.Count" />
        </MultiBinding>
      </StackPanel.IsVisible>
      <Border Classes="skeleton" Width="150" Height="16" HorizontalAlignment="Left" />
      <WrapPanel ItemSpacing="10" LineSpacing="10">
        <Border Classes="skeleton" Width="196" Height="52" CornerRadius="8" />
        <Border Classes="skeleton" Width="196" Height="52" CornerRadius="8" />
        <Border Classes="skeleton" Width="196" Height="52" CornerRadius="8" />
        <Border Classes="skeleton" Width="196" Height="52" CornerRadius="8" />
        <Border Classes="skeleton" Width="196" Height="52" CornerRadius="8" />
        <Border Classes="skeleton" Width="196" Height="52" CornerRadius="8" />
        <Border Classes="skeleton" Width="196" Height="52" CornerRadius="8" />
        <Border Classes="skeleton" Width="196" Height="52" CornerRadius="8" />
      </WrapPanel>
    </StackPanel>

    <ScrollViewer Grid.Row="1" Classes="pagescroll" controls:ScrollMemory.IsEnabled="True">
      <ItemsControl ItemsSource="{Binding Sections}" Margin="4,0">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="core:MoodSection">
            <StackPanel Spacing="10" Margin="0,0,0,24">
              <TextBlock Text="{Binding Title}" FontSize="{StaticResource Token.Font.Section}" FontWeight="Bold" />
              <!-- One tab stop per group, arrows inside it. -->
              <ItemsControl ItemsSource="{Binding Categories}"
                            AutomationProperties.Name="{Binding Title}"
                            controls:RovingFocus.IsEnabled="True">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel ItemSpacing="10" LineSpacing="10" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="core:MoodCategory">
                    <Button Classes="moodtile"
                            AutomationProperties.Name="{Binding Title}"
                            Command="{Binding #Root.((vm:MoodsPageViewModel)DataContext).OpenCategoryCommand}"
                            CommandParameter="{Binding}">
                      <Grid ColumnDefinitions="6,*">
                        <Border Background="{Binding Color, Converter={x:Static vm:Converters.MoodStripe}}" />
                        <TextBlock Grid.Column="1" Text="{Binding Title}" Margin="14,0,10,0"
                                   FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <TextBlock Grid.Row="1" Classes="settinghelp" Margin="4,0,16,0" Text="{l:T moods.empty}" IsVisible="{Binding IsEmpty}" />

    <!-- Load failed with nothing to show: the failure takes the page. Declared
         last, above the empty list, so its buttons get the clicks. -->
    <ContentControl Margin="0,0,12,0" Grid.Row="1" Content="{Binding LoadError}"
                    ContentTemplate="{StaticResource ErrorState.Full}"
                    HorizontalAlignment="Center" VerticalAlignment="Center" />
  </Grid>
</UserControl>
