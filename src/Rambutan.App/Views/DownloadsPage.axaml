<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:Rambutan.App.Localization"
             xmlns:vm="using:Rambutan.App.ViewModels"
             xmlns:controls="using:Rambutan.App.Controls"
             xmlns:conv="using:Rambutan.App.Converters"
             x:Class="Rambutan.App.Views.DownloadsPage"
             x:Name="Root"
             x:DataType="vm:DownloadsPageViewModel">

  <!-- Jobs on top in their own short scroller, so a long playlist download
       doesn't push the finished downloads off the page; the finished list
       below is the page's main, virtualized list. -->
  <Grid RowDefinitions="Auto,Auto,*">
    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" Margin="4,0,16,12">
      <TextBlock Text="{l:T downloads.title}" FontSize="{StaticResource Token.Font.Page}" FontWeight="ExtraBold"
                 VerticalAlignment="Center" />
      <Button Classes="cardplay" Command="{Binding PlayAllCommand}" IsVisible="{Binding HasDownloaded}"
              VerticalAlignment="Center"
              ToolTip.Tip="{l:T common.playAll}" AutomationProperties.Name="{l:T common.playAll}">
        <PathIcon Data="{StaticResource Icon.Play}" Width="18" Height="18" />
      </Button>
      <TextBlock Classes="headersummary" Text="{Binding Summary}" VerticalAlignment="Center"
                 IsVisible="{Binding HasDownloaded}" />
      <Button Content="{l:T downloads.export}" Command="{Binding ExportAllCommand}" IsEnabled="{Binding CanExport}"
              VerticalAlignment="Center" AutomationProperties.Name="{l:T downloads.export}">
        <Button.IsVisible>
          <MultiBinding Converter="{x:Static BoolConverters.And}">
            <Binding Path="ExportEnabled" />
            <Binding Path="HasDownloaded" />
            <Binding Path="!IsExporting" />
          </MultiBinding>
        </Button.IsVisible>
      </Button>
      <!-- While an export runs, its progress takes the Export button's place. -->
      <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" IsVisible="{Binding IsExporting}">
        <TextBlock Classes="rowmeta" Text="{Binding ExportStatus}" VerticalAlignment="Center"
                   AutomationProperties.LiveSetting="Polite" />
        <Button Content="{l:T downloads.export.cancel}" Command="{Binding CancelExportCommand}"
                VerticalAlignment="Center" />
      </StackPanel>
    </StackPanel>

    <StackPanel Grid.Row="1" Spacing="6" Margin="4,0,16,16" IsVisible="{Binding HasJobs}">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <TextBlock Classes="sectiontitle" Text="{l:T downloads.active}" VerticalAlignment="Center" />
        <TextBlock Classes="rowmeta" Text="{Binding JobsSummary}" VerticalAlignment="Center" />
        <Button Content="{l:T downloads.retryAll}" Command="{Binding RetryAllCommand}"
                IsVisible="{Binding HasFailed}" FontSize="12" VerticalAlignment="Center" />
        <Button Content="{l:T downloads.cancelAll}" Command="{Binding CancelAllCommand}"
                FontSize="12" VerticalAlignment="Center" />
      </StackPanel>
      <ScrollViewer MaxHeight="232">
        <ItemsControl ItemsSource="{Binding Jobs}" AutomationProperties.Name="{l:T downloads.activeListName}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:DownloadJobRow">
              <Grid ColumnDefinitions="Auto,*,200,Auto" Margin="0,2" Height="48">
                <Border Classes="rowart">
                  <controls:RemoteImage Url="{Binding Track.ThumbnailUrl}" Stretch="UniformToFill" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                  <TextBlock Classes="rowtitle" Text="{Binding Track.Title}" />
                  <TextBlock Classes="rowmeta" Text="{Binding Track.ArtistDisplay}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center" Margin="12,0">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <PathIcon Data="{StaticResource Icon.Warning}" Width="14" Height="14"
                              Foreground="{StaticResource Token.Brush.Error}" IsVisible="{Binding IsFailed}" />
                    <TextBlock Classes="rowmeta" Text="{Binding Status}" ToolTip.Tip="{Binding Error}" />
                  </StackPanel>
                  <ProgressBar Minimum="0" Maximum="100" Value="{Binding Percent}" Height="4" MinHeight="4"
                               IsIndeterminate="{Binding !HasProgress}"
                               AutomationProperties.Name="{Binding Track.Title}">
                    <ProgressBar.IsVisible>
                      <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="!IsFailed" />
                        <Binding Path="!IsWaiting" />
                      </MultiBinding>
                    </ProgressBar.IsVisible>
                  </ProgressBar>
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                  <Button Classes="icon subtle small" IsVisible="{Binding IsFailed}"
                          Command="{Binding #Root.((vm:DownloadsPageViewModel)DataContext).RetryCommand}"
                          CommandParameter="{Binding}"
                          ToolTip.Tip="{l:T downloads.retry}" AutomationProperties.Name="{l:T downloads.retry}">
                    <PathIcon Data="{StaticResource Icon.Refresh}" Width="16" Height="16" />
                  </Button>
                  <Button Classes="icon subtle small"
                          Command="{Binding #Root.((vm:DownloadsPageViewModel)DataContext).CancelCommand}"
                          CommandParameter="{Binding}"
                          ToolTip.Tip="{l:T downloads.cancel}" AutomationProperties.Name="{l:T downloads.cancel}">
                    <PathIcon Data="{StaticResource Icon.Close}" Width="16" Height="16" />
                  </Button>
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </StackPanel>

    <StackPanel Margin="0,0,12,0" Grid.Row="2" Classes="empty" IsVisible="{Binding IsEmpty}">
      <PathIcon Data="{StaticResource Icon.Download}" />
      <TextBlock Classes="title" Text="{l:T downloads.emptyTitle}" />
      <TextBlock Classes="hint" Text="{l:T downloads.emptyHint}" />
    </StackPanel>

    <DockPanel Grid.Row="2" IsVisible="{Binding HasDownloaded}">
      <TextBlock DockPanel.Dock="Top" Classes="sectiontitle" Text="{l:T downloads.done}" Margin="4,0,16,6"
                 IsVisible="{Binding HasJobs}" />
      <ListBox Classes="tracks pagescroll" Background="Transparent" ItemsSource="{Binding Downloaded}"
               AutomationProperties.Name="{l:T downloads.listName}"
               controls:ScrollMemory.IsEnabled="True"
               controls:ItemActivation.Command="{Binding PlayFromCommand}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:DownloadedRow">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,2" Background="Transparent"
                  Classes.missing="{Binding IsMissing}"
                  controls:TrackMenu.Track="{Binding Track}">
              <Border Classes="rowart">
                <controls:RemoteImage Url="{Binding Track, Converter={x:Static conv:ArtworkConverter.Instance}}" Stretch="UniformToFill" />
              </Border>
              <StackPanel Grid.Column="1" Classes="rowtext" Spacing="1" VerticalAlignment="Center">
                <TextBlock Classes="rowtitle" Text="{Binding Track.Title}" />
                <TextBlock Classes="rowmeta" Text="{Binding Track.ArtistDisplay}" />
              </StackPanel>
              <Panel Grid.Column="2" MinWidth="84">
                <StackPanel Classes="rowactions" Orientation="Horizontal"
                            HorizontalAlignment="Right" VerticalAlignment="Center">
                  <Button Classes="icon subtle small"
                          Command="{Binding #Root.((vm:DownloadsPageViewModel)DataContext).ExportOneCommand}"
                          CommandParameter="{Binding}"
                          IsEnabled="{Binding #Root.((vm:DownloadsPageViewModel)DataContext).CanExport}"
                          ToolTip.Tip="{l:T downloads.export.one}" AutomationProperties.Name="{l:T downloads.export.one}">
                    <Button.IsVisible>
                      <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="#Root.((vm:DownloadsPageViewModel)DataContext).ExportEnabled" />
                        <Binding Path="!IsMissing" />
                      </MultiBinding>
                    </Button.IsVisible>
                    <PathIcon Data="{StaticResource Icon.Export}" Width="16" Height="16" />
                  </Button>
                  <Button Classes="icon subtle small" IsVisible="{Binding IsMissing}"
                          Command="{Binding #Root.((vm:DownloadsPageViewModel)DataContext).DownloadAgainCommand}"
                          CommandParameter="{Binding}"
                          ToolTip.Tip="{l:T downloads.downloadAgain}" AutomationProperties.Name="{l:T downloads.downloadAgain}">
                    <PathIcon Data="{StaticResource Icon.Download}" Width="16" Height="16" />
                  </Button>
                  <Button Classes="icon subtle small"
                          Command="{Binding #Root.((vm:DownloadsPageViewModel)DataContext).RemoveCommand}"
                          CommandParameter="{Binding}"
                          ToolTip.Tip="{l:T downloads.remove}" AutomationProperties.Name="{l:T downloads.remove}">
                    <PathIcon Data="{StaticResource Icon.Delete}" Width="16" Height="16" />
                  </Button>
                </StackPanel>
              </Panel>
              <Panel Grid.Column="3" MinWidth="96" Margin="8,0">
                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right" VerticalAlignment="Center"
                            IsVisible="{Binding IsMissing}" ToolTip.Tip="{l:T downloads.missingTip}">
                  <PathIcon Data="{StaticResource Icon.Warning}" Width="14" Height="14"
                            Foreground="{StaticResource Token.Brush.Error}" />
                  <TextBlock Classes="rowmeta" Text="{l:T downloads.missing}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" VerticalAlignment="Center"
                            IsVisible="{Binding !IsMissing}">
                  <TextBlock Classes="rowmeta" Text="{Binding Size}" />
                  <TextBlock Classes="rowmeta" MinWidth="40" TextAlignment="Right"
                             Text="{Binding Track.Duration, Converter={x:Static conv:DurationFormat.Converter}}" />
                </StackPanel>
              </Panel>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>
  </Grid>
</UserControl>
