<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Follows Rambutan.Integrations: Windows hosts get the Windows TFM (SMTC). -->
    <TargetFramework Condition="$([MSBuild]::IsOSPlatform('Windows'))">net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The exe's own icon (Explorer, pinned shortcuts); the window sets its own. -->
    <ApplicationIcon>Assets\rambutan.ico</ApplicationIcon>
    <!-- Reflection bindings are AOT-hostile; every template declares x:DataType. -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- NativeAOT for publish only; dev builds stay JIT for fast inner loop. -->
    <PublishAot Condition="'$(Configuration)' == 'Release'">true</PublishAot>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />
    <!-- String tables, read by Localization/Strings.cs. -->
    <EmbeddedResource Include="Locales\*.json" LogicalName="Rambutan.App.Locales.%(Filename)%(Extension)" />
    <InternalsVisibleTo Include="Rambutan.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Wayland" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rambutan.Core\Rambutan.Core.csproj" />
    <ProjectReference Include="..\Rambutan.InnerTube\Rambutan.InnerTube.csproj" />
    <ProjectReference Include="..\Rambutan.Streams\Rambutan.Streams.csproj" />
    <ProjectReference Include="..\Rambutan.Audio\Rambutan.Audio.csproj" />
    <ProjectReference Include="..\Rambutan.Lyrics\Rambutan.Lyrics.csproj" />
    <ProjectReference Include="..\Rambutan.Integrations\Rambutan.Integrations.csproj" />
    <ProjectReference Include="..\Rambutan.LocalApi\Rambutan.LocalApi.csproj" />
  </ItemGroup>
</Project>
